		{
			"name": "Submit an order",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\",() =>\r",
							"{\r",
							"    pm.response.to.have.status(201);\r",
							"}\r",
							");\r",
							"\r",
							"var respData = pm.response.json();\r",
							"pm.environment.set(\"id\", respData.orderId);\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{BearerToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [],
				"body": {
