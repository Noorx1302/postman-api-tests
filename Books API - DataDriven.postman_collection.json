							"pm.test(\"Status code is 200\", () =>\r",
							"    {\r",
							"        pm.response.to.have.status(200);\r",
							"    }\r",
							");\r",
							"\r",
							"pm.test(\"Verify order ID\", () =>\r",
							"    {\r",
							"        var resData = pm.response.json();\r",
							"        pm.expect(resData.id).to.eql(pm.environment.get(\"id\"));\r",
